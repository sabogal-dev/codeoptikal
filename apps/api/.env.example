# Copiar este archivo como ".env" y completar los valores.
# El archivo ".env" NO se sube a git. Este ".env.example" SI.

# Puerto donde escucha la API
PORT=3000

# Origen del frontend permitido por CORS (si se omite, usa http://localhost:5173)
CORS_ORIGIN=

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Configuracion JWT
JWT_SECRET=